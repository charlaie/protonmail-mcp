# Proton Bridge credentials from the Bridge app, not your Proton account password.
PROTONMAIL_BRIDGE_USER=
PROTONMAIL_BRIDGE_PASSWORD=

# Proton Bridge local connection settings.
PROTONMAIL_BRIDGE_HOST=127.0.0.1
PROTONMAIL_IMAP_PORT=1143
PROTONMAIL_SMTP_PORT=1025

# Certificate verification may be disabled only on literal loopback addresses
# or localhost. Remote hosts require true and a certificate trusted by Node.js.
PROTONMAIL_TLS_REJECT_UNAUTHORIZED=false

# Optional comma-separated sender aliases belonging to this Bridge account.
# Used to select reply senders, exclude self from reply-all, and validate drafts.
PROTONMAIL_BRIDGE_OWN_ADDRESSES=

# Optional location for the local read allowlist policy.
# Defaults to ~/.config/protonmail-mcp/read-policy.json
PROTONMAIL_MCP_POLICY_FILE=

# Optional private directory for account-specific durable send journals.
# Defaults to send-operations next to the read policy. Keep it across restarts.
PROTONMAIL_MCP_OPERATIONS_DIR=
