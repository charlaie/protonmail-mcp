# Proton Bridge credentials from the Bridge app, not your Proton account password.
PROTONMAIL_BRIDGE_USER=
PROTONMAIL_BRIDGE_PASSWORD=

# Proton Bridge local connection settings.
PROTONMAIL_BRIDGE_HOST=127.0.0.1
PROTONMAIL_IMAP_PORT=1143
PROTONMAIL_SMTP_PORT=1025

# Proton Bridge commonly uses a local certificate. Set true only if your local
# Bridge certificate is trusted by Node.js.
PROTONMAIL_TLS_REJECT_UNAUTHORIZED=false
