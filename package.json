{
	"name": "protonmail-mcp",
	"version": "1.0.0",
	"description": "MCP server for Proton Mail through the local Proton Mail Bridge.",
	"main": "./build/index.js",
	"type": "module",
	"engines": {
		"node": ">=22.16.0"
	},
	"bin": {
		"protonmail-mcp": "./build/index.js"
	},
	"scripts": {
		"check": "biome check --write",
		"test": "pnpm build && node --test \"build/**/*.test.js\" && node build/policy/test.js",
		"prepack": "pnpm build",
		"build": "node scripts/build.mjs",
		"policy:check": "pnpm build && node build/policy/test.js",
		"setup": "pnpm build && node build/index.js setup",
		"policy": "pnpm build && node build/index.js policy",
		"reset-policy": "pnpm build && node build/index.js reset-policy",
		"bridge:list": "pnpm build && node build/index.js bridge:list",
		"bridge:search": "pnpm build && node build/index.js bridge:search",
		"bridge:read": "pnpm build && node build/index.js bridge:read",
		"doctor": "pnpm build && node build/index.js doctor",
		"client-config": "pnpm build && node build/index.js client-config"
	},
	"files": [
		"build",
		"config.example.json",
		"policy.example.json",
		"docs",
		"!build/**/*.test.js",
		"!build/**/*fixture*.js",
		"!build/**/test*.js",
		"!build/**/testing/**"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"protonmail",
		"proton-mail",
		"proton-bridge",
		"email"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/charlaie/protonmail-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/charlaie/protonmail-mcp/issues"
	},
	"homepage": "https://github.com/charlaie/protonmail-mcp#readme",
	"author": "charlaie",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@modelcontextprotocol/server": "^2.0.0",
		"html-to-text": "9.0.5",
		"imapflow": "^1.3.3",
		"jsonc-parser": "^3.3.1",
		"mailparser": "^3.9.8",
		"nodemailer": "^8.0.7",
		"smol-toml": "^1.9.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^25.6.0",
		"@types/nodemailer": "^8.0.0",
		"typescript": "^6.0.3"
	}
}
