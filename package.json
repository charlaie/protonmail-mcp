{
	"name": "protonmail-mcp",
	"version": "1.0.0",
	"description": "MCP server for Proton Mail through the local Proton Mail Bridge.",
	"main": "./build/index.js",
	"type": "module",
	"bin": {
		"protonmail-mcp": "./build/index.js"
	},
	"scripts": {
		"check": "biome check --write",
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepack": "pnpm build",
		"build": "node -e \"fs.rmSync('build', { recursive: true, force: true })\" && tsc && chmod 755 build/index.js && chmod 755 build/policy/cli.js",
		"policy:check": "pnpm build && node build/policy/test.js",
		"setup": "pnpm build && node build/index.js setup",
		"policy": "pnpm build && node build/index.js policy",
		"reset-policy": "pnpm build && node build/index.js reset-policy",
		"bridge:list": "pnpm build && node build/index.js bridge:list",
		"bridge:search": "pnpm build && node build/index.js bridge:search",
		"bridge:read": "pnpm build && node build/index.js bridge:read",
		"bridge:send-test": "pnpm build && node build/index.js bridge:send-test"
	},
	"files": [
		"build"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"protonmail",
		"proton-mail",
		"proton-bridge",
		"email"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/charlaie/protonmail-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/charlaie/protonmail-mcp/issues"
	},
	"homepage": "https://github.com/charlaie/protonmail-mcp#readme",
	"author": "charlaie",
	"license": "MIT",
	"packageManager": "pnpm@10.33.2",
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"html-to-text": "9.0.5",
		"imapflow": "^1.3.3",
		"mailparser": "^3.9.8",
		"nodemailer": "^8.0.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^25.6.0",
		"@types/nodemailer": "^8.0.0",
		"typescript": "^6.0.3"
	}
}
